# pmu_metrics/BUILD.gn
#
# Minimal stub build — no Perfetto dep, no linux/perf_event.h, no pthreads.
# Goal: integrate into the host project and nail down the interface before
# adding real hardware counter collection.

config("public_config") {
  include_dirs = [ "include" ]
}

config("private_config") {
  cflags_cc = [
    "-std=c++17",
    "-Wall",
    "-Wextra",
    "-Wno-unused-parameter",
    "-fvisibility=hidden",
    "-fvisibility-inlines-hidden",
  ]
}

shared_library("pmu_metrics") {
  output_name = "pmu_metrics"

  sources = [ "src/pmu_metrics.cc" ]
  public  = [ "include/pmu_metrics/pmu_metrics.h" ]

  public_configs = [ ":public_config" ]
  configs       += [ ":private_config" ]

  # No external deps in this iteration.
}
